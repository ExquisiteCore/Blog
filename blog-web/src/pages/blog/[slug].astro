---
export const prerender = false;
const { slug } = Astro.params;

import Layout from "@/layouts/Layout.astro";
import BlogPost from "@/components/solid/BlogPost";

// 尝试获取文章信息用于SEO（如果失败则使用默认值）
let post = null;
try {
  const apiUrl = import.meta.env.SSR
    ? import.meta.env.INTERNAL_API_BASE_URL || "http://backend:8080/api"
    : import.meta.env.PUBLIC_API_BASE_URL ||
      "https://api.exquisitecore.xyz/api";

  const response = await fetch(`${apiUrl}/posts/${slug}`);
  if (response.ok) {
    post = await response.json();
  }
} catch (error) {
  console.error("Failed to fetch post for SEO:", error);
}

// SEO 信息
const title = post
  ? `${post.title} | ExquisiteCore Blog`
  : "博客文章 | ExquisiteCore Blog";
const description = post
  ? post.excerpt || `阅读ExquisiteCore的文章：${post.title}`
  : "ExquisiteCore的技术博客文章";
const keywords = post
  ? `${post.title},${post.labels?.join(",") || ""},ExquisiteCore,技术博客`
  : "技术博客,ExquisiteCore";
const publishedTime = post?.published_at;
const modifiedTime = post?.updated_at;
const tags = post?.labels || [];
const featuredImage = post?.featured_image
  ? post.featured_image.replace(/`/g, "").trim()
  : "https://blog.exquisitecore.xyz/logo.svg";
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  type="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  section="技术博客"
  tags={tags}
  image={featuredImage}
>
  <BlogPost client:load slug={slug ?? ""} />
</Layout>
