---
export const prerender = false;
import Layout from "@/layouts/Layout.astro";
import BlogPosts from "@/components/solid/BlogPosts";
---

<Layout
    title="博客文章 | ExquisiteCore - 技术分享与思考"
    description="浏览ExquisiteCore的所有博客文章，包含全栈开发、游戏开发、编程技巧和技术思考。发现最新的技术文章和项目分享。"
    keywords="博客文章,技术博客,全栈开发,游戏开发,编程教程,技术分享,ExquisiteCore"
    type="website"
>
    <div class="container mx-auto px-4">
        <div class="text-left my-8">
            <h1 class="text-4xl font-bold">博客文章</h1>
            <p class="mt-2 text-lg">探索我的最新文章和想法</p>
        </div>

        <!-- 文章列表 -->
        <BlogPosts client:load />
    </div>
</Layout>
