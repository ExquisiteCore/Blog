---
import Layout from "@/layouts/Layout.astro";
import ToolList from "@/components/solid/ToolList";

const categories = [
    { id: "text", name: "文档" },
    { id: "editor", name: "编辑器" },
    { id: "devtool", name: "开发工具" },
];
---

<Layout
    title="ECTools - 精致的工具箱 | ExquisiteCore 在线工具集"
    description="ExquisiteCore的在线工具集合，包含文档处理、编辑器、开发工具等实用工具。提高工作效率的免费在线工具箱。"
    keywords="在线工具,工具箱,ECTools,文档工具,编辑器,开发工具,ExquisiteCore,免费工具"
    type="website"
>
    <div class="relative min-h-screen">
        <div class="container mx-auto px-4 py-8">
            <!-- 标题 -->
            <h1 class="text-5xl font-bold mb-6">ECTools</h1>

            <!-- 分类标签 -->
            <div class="flex flex-wrap gap-2 mb-8">
                <a
                    href="/tools"
                    class="btn btn-sm btn-outline rounded-full text-sm transition-all"
                >
                    全部
                </a>
                {
                    categories.map((category) => (
                        <a
                            href={`/tools?category=${category.id}`}
                            class="btn btn-sm btn-outline rounded-full text-sm transition-all"
                        >
                            {category.name}
                        </a>
                    ))
                }
            </div>

            <!-- 工具介绍 -->
            <p class="text-lg mb-10 opacity-80">
                我会在这个平台上分享我开发的一些小工具，当然，许多工具都是为了我个人能够使用方便而开发的。
            </p>

            <!-- 工具卡片列表 -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <ToolList client:load />
            </div>

            <!-- 底部 -->
            <div class="mt-16 mb-8 text-center">
                <div
                    class="w-24 h-1 bg-gradient-to-r from-primary to-secondary mx-auto mb-6 rounded-full"
                >
                </div>
                <p class="text-base-content/70">
                    更多工具正在开发中，敬请期待...
                </p>
                <div class="mt-4 flex justify-center gap-4">
                    <a href="/" class="btn btn-sm btn-ghost"> 返回首页 </a>
                    <a
                        href="https://github.com/ExquisiteCore"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-sm btn-ghost"
                    >
                        GitHub
                    </a>
                </div>
            </div>
        </div>
    </div>
</Layout>
