---
import Layout from "@/layouts/Layout.astro";

// 工具分类
const categories = [
    { id: "markdown", name: "markdown" },
    { id: "文档", name: "文档" },
];

// 工具列表
const tools = [
    {
        id: "markdownrender",
        name: "md编辑器",
        description:
            "一款基于React的Markdown编辑器，支持实时预览、导出、导入、复制、粘贴、撤销、重做、全屏、快捷键等功能。",
        category: ["text", "markdown"],
        image: "/markdown-svgrepo-com.svg",
    },
];
---

<Layout title="精致的工具箱 | ExquisiteCore - 精致的私人博客">
    <div class="relative min-h-screen">
        <div class="container mx-auto px-4 py-8">
            <!-- 标题 -->
            <h1 class="text-5xl font-bold mb-6">ECTools</h1>

            <!-- 分类标签 -->
            <div class="flex flex-wrap gap-2 mb-8">
                {
                    categories.map((category) => (
                        <button class="btn btn-sm btn-outline rounded-full text-sm bg-purple-100 text-purple-800 hover:bg-purple-200 border-none">
                            {category.name}
                        </button>
                    ))
                }
            </div>

            <!-- 介绍文本 -->
            <p class="text-lg mb-10 opacity-80">
                我会在这个平台上分享我开发的一些小工具，当然，许多工具都是为了我个人能够使用方便而开发的。
            </p>

            <!-- 工具卡片网格 -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    tools.map((tool) => (
                        <a
                            href={`/tools/${tool.id}`}
                            class="card h-full cursor-pointer transition-all hover:shadow-lg hover:-translate-y-1 overflow-hidden border-0 bg-white/80"
                        >
                            <div class="aspect-video w-full overflow-hidden rounded-t-xl">
                                <div class="relative h-full w-full">
                                    <img
                                        src={tool.image}
                                        alt={tool.name}
                                        class="h-full w-full object-cover"
                                    />
                                </div>
                            </div>
                            <div class="card-body p-5">
                                <div class="flex items-center gap-2 mb-2">
                                    <div class="flex items-center justify-center w-6 h-6 bg-purple-600 text-white rounded-md font-bold text-xs">
                                        EC
                                    </div>
                                    <div class="flex flex-wrap gap-1">
                                        {Array.isArray(tool.category) ? (
                                            tool.category.map((cat) => (
                                                <span class="badge badge-sm bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200 text-xs px-2 py-1 rounded-full">
                                                    {cat}
                                                </span>
                                            ))
                                        ) : (
                                            <span class="badge badge-sm bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200 text-xs px-2 py-1 rounded-full">
                                                {tool.category}
                                            </span>
                                        )}
                                    </div>
                                </div>
                                <h2 class="card-title text-xl mb-2 mt-1">
                                    {tool.name}
                                </h2>
                                <p class="opacity-80">{tool.description}</p>
                            </div>
                        </a>
                    ))
                }
            </div>

            <!-- 底部信息 -->
            <div class="mt-16 mb-8 text-center">
                <div
                    class="w-24 h-1 bg-gradient-to-r from-purple-600 to-blue-500 mx-auto mb-6 rounded-full"
                >
                </div>
                <p class="text-gray-600 dark:text-gray-400">
                    更多工具正在开发中，敬请期待...
                </p>
                <div class="mt-4">
                    <a
                        href="/"
                        class="text-purple-600 hover:text-purple-800 transition-colors font-medium"
                        >返回首页</a
                    >
                </div>
            </div>
        </div>
    </div>
</Layout>
