*.test.ts
*.spec.js
*.spec.ts

# WASM source (we copy it explicitly)
md-wasm/target/
md-wasm/Cargo.lock

# Logs
*.log
logs/

# Runtime
*.pid
*.seed
*.pid.lock

# Temporary files
tmp/
temp/

