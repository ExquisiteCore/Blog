.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
*.tmp
*.temp

# Git
.git/
.gitignore

# Environment files
.env*
!.env.example

# Documentation
README.md
*.md
docs/

# Test files
test/
tests/
__tests__/
coverage/
