---
import Layout from "../layouts/Layout.astro";
import Clock from "../components/Clock.astro";
import Button from "../components/ui/Button.astro";
import Tooltip from "../components/ui/Tooltip.astro";
import GithubIcon from "../components/icons/GithubIcon.astro";
---

<Layout>
    <div class="container mx-auto py-12 px-4 md:px-6 min-h-[calc(100vh-64px)]">
        <div class="max-w-4xl mx-auto space-y-8">
            {/* 标题部分 */}
            <div class="text-center mb-6">
                <h1 class="text-3xl md:text-4xl font-bold tracking-tight">
                    你好，我是 ExquisiteCore 👋
                </h1>
            </div>

            {/* 个人信息部分 */}
            <div class="bg-white p-8 rounded-xl shadow-sm">
                <div class="flex flex-col md:flex-row justify-between">
                    <div class="flex-1">
                        <h2 class="text-2xl font-bold mb-5">关于我</h2>
                        <ul class="space-y-4 list-disc list-inside">
                            <li>一名热爱开源的中国学生</li>
                            <li>动漫爱好者</li>
                            <li>喜欢生电但不精通的Minecraft玩家</li>
                        </ul>

                        <div class="mt-5">
                            <p class="font-medium mb-3">喜欢的编程语言</p>
                            <div class="flex flex-wrap gap-2">
                                <span
                                    class="bg-purple-600 text-white px-3 py-1 rounded text-sm"
                                    >Csharp</span
                                >
                                <span
                                    class="bg-blue-500 text-white px-3 py-1 rounded text-sm"
                                    >C++</span
                                >
                                <span
                                    class="bg-amber-600 text-white px-3 py-1 rounded text-sm"
                                    >Rust</span
                                >
                            </div>
                        </div>

                        <div class="mt-5">
                            <p class="font-medium mb-3">我的系统</p>
                            <div class="flex flex-wrap gap-2">
                                <span
                                    class="bg-blue-500 text-white px-3 py-1 rounded text-sm"
                                    >windows</span
                                >
                                <span
                                    class="bg-orange-500 text-white px-3 py-1 rounded text-sm"
                                    >Mac</span
                                >
                            </div>
                        </div>

                        <p class="mt-5">
                            喜欢写一些简单的代码和一些好玩的小东西
                        </p>
                    </div>

                    <div class="md:ml-8 mt-6 md:mt-0">
                        <Clock />
                    </div>
                </div>
            </div>

            {/* 爱好部分 */}
            <div class="bg-white p-8 rounded-xl shadow-sm">
                <h2 class="text-2xl font-bold mb-5">我的爱好</h2>
                <ul
                    class="grid grid-cols-1 md:grid-cols-2 gap-4 list-disc list-inside"
                >
                    <li>喜欢尝试各种新鲜事物和折腾</li>
                    <li>动漫and二刺螈</li>
                    <li>水群</li>
                    <li>来点Music</li>
                    <li>美味的东西</li>
                    <li>打游戏</li>
                    <li>
                        喜欢计算机，目前主要是C#，C++和Rust，进一步的东西还在学习中...
                    </li>
                    <li>刷机(才不是大变活砖)</li>
                    <li>目前正在写一些好玩的项目(鸽子)，快来给我点star</li>
                </ul>
            </div>

            {/* GitHub链接 */}
            <div class="flex justify-center mt-8">
                <a
                    href="https://github.com/ExquisiteCore"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 bg-white px-6 py-3 rounded-md shadow-sm hover:bg-gray-50 transition-colors"
                >
                    <GithubIcon size="20px" />
                    <span>访问我的GitHub</span>
                </a>
            </div>
        </div>
    </div>
</Layout>
