---
interface Props {
  size?: string;
  className?: string;
}
---

<div id="clock-container" class={`bg-gray-100 rounded-full flex items-center justify-center text-gray-700 border border-gray-300 shadow-sm ${Astro.props.className || ''}`} style={`width: ${Astro.props.size || '8rem'}; height: ${Astro.props.size || '8rem'};`}>
  <span id="clock" class="text-xl font-mono"></span>
</div>

<script>
  // 简单的时钟实现
  function updateClock() {
    const clockElement = document.getElementById('clock');
    if (clockElement) {
      const now = new Date();
      const hours = now.getHours().toString().padStart(2, '0');
      const minutes = now.getMinutes().toString().padStart(2, '0');
      const seconds = now.getSeconds().toString().padStart(2, '0');
      clockElement.textContent = `${hours}:${minutes}:${seconds}`;
    }
  }

  // 初始化并每秒更新时钟
  updateClock();
  setInterval(updateClock, 1000);
</script>