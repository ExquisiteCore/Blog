---
import { mainNavItems } from "../data/navigation";
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 opacity-0">
  <div class="backdrop-blur-md bg-white/70 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <div class="flex-shrink-0">
          <a href="/" class="text-xl font-bold text-gray-800">ExquisiteCore</a>
        </div>
        <nav class="hidden md:block">
          <ul class="flex space-x-8">
            {
              mainNavItems.map(item => (
                <li>
                  <a 
                    href={item.href} 
                    class="text-gray-700 hover:text-pink-600 font-medium transition-colors duration-200"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <button 
          id="mobile-menu-button" 
          type="button" 
          class="md:hidden inline-flex items-center justify-center p-2 rounded-md text-gray-700 hover:text-pink-600 hover:bg-gray-100 focus:outline-none"
        >
          <span class="sr-only">打开菜单</span>
          <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
    
    <!-- 移动端菜单 - 默认隐藏 -->
    <div id="mobile-menu" class="hidden md:hidden">
      <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
        {
          mainNavItems.map(item => (
            <a
              href={item.href}
              class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-pink-600 hover:bg-gray-50"
            >
              {item.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</header>

<script>
  // 获取头部元素
  const header = document.getElementById('site-header');
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  
  // 上一次滚动位置
  let lastScrollTop = 0;
  
  // 移动菜单切换
  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
  
  // 添加节流函数
  function throttle(func, delay) {
    let lastCall = 0;
    return function(...args) {
      const now = new Date().getTime();
      if (now - lastCall < delay) {
        return;
      }
      lastCall = now;
      return func(...args);
    }
  }
  
  // 滚动方向和距离检测
  let scrollDistance = 0;
  const scrollThreshold = 50; // 需要滚动的距离阈值
  
  // 节流后的滚动事件处理
  const handleScroll = throttle(() => {
    const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
    
    // 在顶部时透明
    if (scrollTop < 10) {
      header?.classList.remove('opacity-100');
      header?.classList.add('opacity-0');
      scrollDistance = 0;
      return;
    }
    
    // 计算滚动距离
    if (scrollTop > lastScrollTop) {
      // 向下滚动
      scrollDistance += (scrollTop - lastScrollTop);
      
      // 只有当累积滚动距离超过阈值时才隐藏
      if (scrollDistance > scrollThreshold && scrollTop > 150) {
        header?.classList.remove('opacity-100');
        header?.classList.add('-translate-y-full', 'opacity-0');
      }
    } else {
      // 向上滚动 - 立即显示
      scrollDistance = 0;
      header?.classList.remove('-translate-y-full', 'opacity-0');
      header?.classList.add('opacity-100');
    }
    
    lastScrollTop = scrollTop;
  }, 100); // 100ms的节流延迟
  
  window.addEventListener('scroll', handleScroll);
  
  // 初始状态设置
  window.addEventListener('DOMContentLoaded', () => {
    const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
    if (scrollTop > 10) {
      header?.classList.add('opacity-100');
    }
  });
</script>