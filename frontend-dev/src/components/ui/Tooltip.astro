---
interface Props {
  content: string;
  position?: 'top' | 'bottom' | 'left' | 'right';
  trigger?: 'hover' | 'click';
  class?: string;
}

const {
  content,
  position = 'top',
  trigger = 'hover',
  class: className = '',
} = Astro.props;

// 计算箭头位置的类名
const arrowPositionClass = {
  top: 'bottom-0 left-1/2 -translate-x-1/2 translate-y-full border-t-black border-l-transparent border-r-transparent',
  bottom: 'top-0 left-1/2 -translate-x-1/2 -translate-y-full rotate-180 border-t-black border-l-transparent border-r-transparent',
  left: 'right-0 top-1/2 translate-x-full -translate-y-1/2 rotate-90 border-t-black border-l-transparent border-r-transparent',
  right: 'left-0 top-1/2 -translate-x-full -translate-y-1/2 -rotate-90 border-t-black border-l-transparent border-r-transparent',
}[position];

// 计算提示气泡位置的类名
const tooltipPositionClass = {
  top: 'bottom-full left-1/2 -translate-x-1/2 mb-2',
  bottom: 'top-full left-1/2 -translate-x-1/2 mt-2',
  left: 'right-full top-1/2 -translate-y-1/2 mr-2',
  right: 'left-full top-1/2 -translate-y-1/2 ml-2',
}[position];

// 基于触发方式的类名
const triggerClass = trigger === 'hover' 
  ? 'group-hover:visible group-hover:opacity-100' 
  : 'peer-focus:visible peer-focus:opacity-100';
---

<div class={`relative inline-block ${trigger === 'hover' ? 'group' : ''} ${className}`}>
  <slot name="trigger" />
  <div class={`absolute invisible opacity-0 transition-opacity duration-200 ${tooltipPositionClass} ${triggerClass} px-3 py-1.5 bg-gray-900 text-white text-sm rounded-lg z-10 min-w-max max-w-xs text-center`}>
    {content}
    <div class={`absolute w-0 h-0 border-4 ${arrowPositionClass}`}></div>
  </div>
</div>

<style>
  /* 避免在点击触发模式下，点击提示时隐藏 */
  div[class*="peer-focus"] {
    pointer-events: none;
  }
</style>