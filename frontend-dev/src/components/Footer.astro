---
// 动态获取当前年份
const currentYear = new Date().getFullYear();

// 导入共享导航数据
import {
    mainNavItems,
    additionalPageLinks,
    socialLinks,
} from "../data/navigation";
---

<footer
    class="bg-gray-50 text-gray-700 py-10 mt-auto rounded-t-3xl shadow-inner"
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-8">
            <!-- 关于博客 -->
            <div class="mb-6 md:mb-0">
                <h2
                    class="text-2xl font-bold text-gray-800 mb-4 border-b border-gray-200 pb-2 inline-block"
                >
                    精致的博客
                </h2>
                <p class="text-gray-600 mb-3 flex items-center">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5 mr-2 text-gray-500"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                        ></path>
                    </svg>
                    xiaolongqq1y@163.com
                </p>
                <p class="text-gray-600 mb-4 flex items-center">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5 mr-2 text-gray-500"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4"
                        ></path>
                    </svg>
                    © {currentYear} 精致的博客. 保留所有权利.
                </p>
            </div>

            <!-- 快速链接 -->
            <div>
                <h3
                    class="text-xl font-semibold mb-4 text-gray-800 border-b border-gray-200 pb-2"
                >
                    快速链接
                </h3>
                <div class="grid grid-cols-2 gap-2">
                    {/* 主导航链接 */}
                    {
                        mainNavItems.map((link) => (
                            <a
                                href={link.href}
                                class="text-gray-600 hover:text-indigo-600 hover:underline transition-colors duration-200"
                            >
                                {link.label}
                            </a>
                        ))
                    }

                    {/* 其他页面链接 */}
                    {
                        additionalPageLinks.map((link) => (
                            <a
                                href={link.href}
                                class="text-gray-600 hover:text-indigo-600 hover:underline transition-colors duration-200"
                            >
                                {link.label}
                            </a>
                        ))
                    }
                </div>
            </div>

            <!-- 相关链接 -->
            <div>
                <h3
                    class="text-xl font-semibold mb-4 text-gray-800 border-b border-gray-200 pb-2"
                >
                    相关链接
                </h3>
                <ul class="space-y-3">
                    {
                        socialLinks.map((link) => (
                            <li class="flex items-center">
                                <a
                                    href={link.href}
                                    class="flex items-center text-gray-600 hover:text-indigo-600 hover:translate-x-1 transition-all duration-200"
                                    target="_blank"
                                >
                                    <span
                                        class={`${link.color} rounded-full w-8 h-8 flex items-center justify-center mr-2 shadow-sm`}
                                    >
                                        {link.icon}
                                    </span>
                                    {link.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>

        <div
            class="pt-8 border-t border-gray-200 flex flex-col md:flex-row justify-between items-center"
        >
            <p class="text-gray-500 text-sm mb-4 md:mb-0">
                © {currentYear} 精致的博客. 保留所有权利.
            </p>
            <p class="text-gray-500 text-sm">
                感谢您的访问！本站点内容仅供参考，欢迎交流与分享。
            </p>
        </div>
    </div>
</footer>
